# Скопіюйте у .env і заповніть. Файл .env у git не потрапляє.

# Ім'я Compose-проєкту (необов'язково). Локально задайте окреме, щоб не змішувати томи.
# COMPOSE_PROJECT_NAME=digicomp-local

# База даних (PostgreSQL)
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=

# Секрет для підпису JWT. Згенерувати: openssl rand -base64 48
JWT_SECRET=

# Прапорець Secure для cookie входу. true, коли сайт відкривають через https.
COOKIE_SECURE=false

# Публічна адреса сайту, потрапляє в QR-коди. Без неї береться адреса запиту.
# PUBLIC_ORIGIN=https://digicomp.example.ts.net

# Дозволені джерела для CORS через кому (зазвичай не потрібно: фронт на тому ж домені).
# CORS_ORIGINS=

# Довіра до X-Forwarded-For, якщо перед API стоїть власний reverse proxy (наприклад 1 або loopback).
# TRUST_PROXY=

# Home Assistant. Без токена розділ /smart відповідає помилкою, решта API працює.
# HA_URL=http://host.docker.internal:8123
# HA_TOKEN=

# Через скільки годин сервер сам закриває забутий сеанс роботи з обладнанням.
# SESSION_AUTO_CLOSE_HOURS=12

# Розширена панель, див. docs/tech/OPERATIONS.md («Розширена панель і агент»).
# Токен для агента на сервері (той самий, що в /etc/digicomp-agent.env). Згенерувати: openssl rand -hex 32
# AGENT_TOKEN=
# Ключ шифрування секретів 2FA, 32 байти в base64. Згенерувати: openssl rand -base64 32
# Без нього 2FA не вмикається, а без 2FA панель недоступна. Не змінюйте після запуску: увімкнена 2FA перестане працювати.
# TOTP_KEY=
