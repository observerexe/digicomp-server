{
  "name": "digicomp-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run tokens && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint src",
    "tokens": "node scripts/tokens.mjs",
    "api:types": "openapi-typescript ../api/openapi.json -o src/api/schema.d.ts",
    "fonts": "node scripts/fonts.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "jsqr": "^1.4.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.93.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wawoff2": "^2.0.1"
  }
}
